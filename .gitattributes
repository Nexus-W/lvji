* text=auto eol=lf

# Windows / Unix 脚本保持各自行尾，避免 clone 后无法执行
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.apk  binary
*.hap  binary
*.p12  binary
*.p7b  binary
*.jar  binary
